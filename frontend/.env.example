# Frontend environment

# When true (default) the UI reads from src/mocks/*.ts.
# Set to false once the FastAPI backend is running.
VITE_USE_MOCKS=true

# Base URL used when VITE_USE_MOCKS=false.
# If it starts with "/", requests are sent relative to the current host
# (use this when the frontend is served from the same origin / via Vite proxy).
VITE_API_URL=/api
